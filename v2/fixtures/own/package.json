{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "json-to-toon-converter",
  "title": "JSON to TOON Converter",
  "description": "Convert JSON data into TOON format instantly.",
  "icon": "assets/extension-icon.png",
  "author": "almatkai",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "convert-json",
      "title": "Convert JSON",
      "subtitle": "TOON Format",
      "description": "Convert JSON to TOON format",
      "mode": "no-view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "preferences": [
    {
      "name": "defaultAction",
      "type": "dropdown",
      "required": false,
      "title": "Default Action",
      "description": "Choose whether to copy the result or paste it to the active application by default.",
      "default": "copy",
      "data": [
        {
          "title": "Copy to Clipboard",
          "value": "copy"
        },
        {
          "title": "Paste to Active App",
          "value": "paste"
        }
      ]
    },
    {
      "name": "inputSource",
      "type": "dropdown",
      "required": false,
      "title": "Input Source",
      "description": "Choose whether to try selected text first or always use clipboard.",
      "default": "auto",
      "data": [
        {
          "title": "Auto (Selection then Clipboard)",
          "value": "auto"
        },
        {
          "title": "Clipboard Only",
          "value": "clipboard"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2",
    "@toon-format/toon": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.json-to-toon-converter",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/json-to-toon-converter",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/json-to-toon-converter",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
