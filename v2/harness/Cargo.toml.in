[package]
name = "toon-beta-contract-harness"
version = "0.1.0"
edition = "2021"
rust-version = "1.85"
publish = false

[dependencies]
serde_json = "=1.0.145"
ryu-js = "=1.0.2"
tokio = { version = "=1.44.2", features = ["rt-multi-thread", "macros", "sync", "time"] }
uuid = { version = "=1.16.0", features = ["v4"] }
log = "=0.4.28"
tempfile = "=3.20.0"
base64 = "=0.22.1"
sha2 = "=0.10.9"
tauri = { path = "tauri-stub" }
